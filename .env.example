# Fixed synthetic local values only. Copy to .env; never put real credentials here.
# Local development runs against the Docker Postgres from `docker compose up -d --wait`;
# on Databricks Apps every one of these comes from the platform or the bundle
# (docs/DEPLOYMENT.md) and this file is not read.
CAOS_DATABASE_URL=postgresql://caos_app:local-app-only@127.0.0.1:55436/caos_dev
CAOS_TEST_POSTGRES_URL=postgresql://postgres:local-test-admin-only@127.0.0.1:55437/postgres
# Where scripts/qualify.py keeps a paid run's database: the persistent dev server,
# never the in-memory test server above.
CAOS_QUALIFY_POSTGRES_URL=postgresql://caos_dev_admin:local-dev-admin-only@127.0.0.1:55436/caos_dev
CAOS_BLOB_ROOT=.dev-data/blobs
CAOS_TRUST_ROLE_HEADER=1
CAOS_REQUIRE_POSTGRES=1

# The local actor the dev UI proxy asserts; the browser cannot choose its own.
# Unset CAOS_DEV_USER and the API answers 401. Never read in production.
CAOS_DEV_USER=00000000-0000-4000-8000-00000000d001
CAOS_DEV_ROLE=ANALYST

# The gateway endpoint the model factory calls, and its dated per-token price
# (`endpoint,input_per_token,output_per_token,YYYY-MM-DD`). The worker refuses
# to start without the price; no model credential is ever configured here --
# the SDK's unified auth (a CLI profile locally, the app's service principal on
# Databricks) is the whole of it.
# CAOS_MODEL_ENDPOINT=databricks-claude-opus-5
# CAOS_MODEL_PRICE=databricks-claude-opus-5,0.000005,0.000025,2026-09-22
# The other approved endpoints a run may be started on, each priced the same
# way, joined by `;` (F468); unset, the endpoint above is the only one.
# CAOS_MODEL_CHOICES=
# CAOS_RUN_CEILING=120.00
# CAOS_WORKER_IN_PROCESS=1

# Test-only: the OpenRouter adapter under tests/ reads this name at call time.
# OPENROUTER_API_KEY=
# CAOS_REQUIRE_PROVIDER=1

# Set by the bundle and the platform on Databricks Apps only (docs/DEPLOYMENT.md);
# listed so the doctor can name them. Leave them absent locally.
# CAOS_SITE_ROOT=frontend/dist
# CAOS_BIND_HOST=0.0.0.0
# CAOS_WORKER_IN_PROCESS=1
# CAOS_PUBLIC_ORIGIN=
# CAOS_UC_SCHEMA=
# Exactly one of these two (R24-14): an Autoscaling endpoint's resource path
# (the default kind) or an existing Provisioned instance's name.
# CAOS_LAKEBASE_ENDPOINT=
# CAOS_LAKEBASE_INSTANCE=
# CAOS_GROUP_ADMIN=caos-admins
# CAOS_GROUP_ANALYST=caos-analysts
# CAOS_REASONING_EFFORT=
# DATABRICKS_APP_NAME=
