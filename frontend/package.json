{
  "name": "caos-workspace",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "dev:demo": "vite --mode demo",
    "build": "vite build && node scripts/export-sections.mjs dist",
    "build:demo": "vite build --mode demo --outDir dist-demo && node scripts/export-sections.mjs dist-demo",
    "preview": "vite preview --strictPort --port 4173",
    "preview:demo": "vite preview --mode demo --outDir dist-demo --strictPort --port 4173",
    "lint": "eslint --max-warnings=0 . && prettier --check . && node scripts/check-vocabulary.mjs && node scripts/check-tested.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --mode demo",
    "a11y": "node scripts/a11y-axe.mjs",
    "test:workbench": "playwright test"
  },
  "dependencies": {
    "@base-ui/react": "1.8.0",
    "@fontsource-variable/geist": "5.3.0",
    "@fontsource-variable/geist-mono": "5.3.0",
    "@tailwindcss/vite": "4.3.3",
    "class-variance-authority": "0.7.1",
    "cn": "0.4.0",
    "lucide-react": "1.47.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-router": "7.18.3",
    "recharts": "3.10.1",
    "tailwindcss": "4.3.3"
  },
  "devDependencies": {
    "@playwright/test": "1.61.1",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "24.13.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "axe-core": "4.13.0",
    "eslint": "9.39.5",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react-hooks": "7.1.1",
    "jscpd": "^5.3.1",
    "jsdom": "27.4.0",
    "playwright": "1.61.1",
    "prettier": "3.9.6",
    "typescript": "5.9.3",
    "typescript-eslint": "8.70.0",
    "vite": "6.4.3",
    "vitest": "4.1.11"
  }
}
