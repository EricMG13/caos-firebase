{
  "displayName": "caos Cloud Run memory high",
  "combiner": "OR",
  "conditions": [
    {
      "displayName": "Memory utilization p99 above 85% for 5 min",
      "conditionThreshold": {
        "filter": "metric.type=\"run.googleapis.com/container/memory/utilizations\" AND resource.type=\"cloud_run_revision\" AND resource.label.service_name=\"caos\"",
        "aggregations": [
          {"alignmentPeriod": "60s", "perSeriesAligner": "ALIGN_PERCENTILE_99"}
        ],
        "comparison": "COMPARISON_GT",
        "thresholdValue": 0.85,
        "duration": "300s",
        "trigger": {"count": 1}
      }
    }
  ],
  "notificationChannels": ["projects/PROJECT_ID/notificationChannels/CHANNEL_ID"]
}
